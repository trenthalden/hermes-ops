--- a/tests/agent/test_credential_pool_codex_singleton_isolation.py
+++ b/tests/agent/test_credential_pool_codex_singleton_isolation.py
@@ -106,0 +107,109 @@
+
+
+@pytest.mark.parametrize(
+    "borrowed_root", [False, True], ids=["profile-store", "borrowed-root-store"]
+)
+def test_independent_manual_account_forced_refresh_adopts_peer_rotation(
+    home, monkeypatch, borrowed_root
+):
+    """A second pool snapshot must use the exact manual row under its owner lock."""
+    from contextlib import contextmanager
+
+    import agent.credential_pool as CP
+    import hermes_cli.auth as auth_mod
+
+    now = time.time()
+    a_at = _jwt("acct-A", "user-A", now + 8 * 3600)
+    b_at = _jwt("acct-B", "user-B", now + 60)
+    _write_store(
+        home,
+        {"access_token": a_at, "refresh_token": "YOUR_TEST_REFRESH_TOKEN_A"},
+        _iso(now - 3600),
+        {
+            "access_token": b_at,
+            "refresh_token": "YOUR_TEST_REFRESH_TOKEN_B",
+            "last_refresh": _iso(now - 7200),
+        },
+    )
+    authoritative_path = home / "auth.json"
+    active_path = authoritative_path
+    if borrowed_root:
+        profile = home / "profiles" / "borrower"
+        profile.mkdir(parents=True)
+        active_path = profile / "auth.json"
+        active_path.write_text(json.dumps({"version": 1, "providers": {}}), encoding="utf-8")
+        monkeypatch.setenv("HERMES_HOME", str(profile))
+        monkeypatch.setattr(auth_mod, "_auth_file_path", lambda: active_path)
+        monkeypatch.setattr(auth_mod, "_global_auth_file_path", lambda: authoritative_path)
+        monkeypatch.setattr(CP, "_global_auth_file_path", lambda: authoritative_path)
+        monkeypatch.setattr(CP, "_borrowed_single_use_pool_root", lambda: authoritative_path)
+    else:
+        monkeypatch.setattr(auth_mod, "_global_auth_file_path", lambda: None)
+        monkeypatch.setattr(CP, "_global_auth_file_path", lambda: None)
+        monkeypatch.setattr(CP, "_borrowed_single_use_pool_root", lambda: None)
+    auth_mod._global_auth_store_cache = None
+
+    real_lock = auth_mod._auth_store_lock
+    held: dict[str, int] = {}
+
+    @contextmanager
+    def tracking_lock(timeout_seconds=15.0, *, target_path=None):
+        path = target_path if target_path is not None else auth_mod._auth_file_path()
+        key = str(path.resolve())
+        with real_lock(timeout_seconds=timeout_seconds, target_path=target_path):
+            held[key] = held.get(key, 0) + 1
+            try:
+                yield
+            finally:
+                held[key] -= 1
+                if held[key] == 0:
+                    held.pop(key)
+
+    monkeypatch.setattr(auth_mod, "_auth_store_lock", tracking_lock)
+    monkeypatch.setattr(CP, "_auth_store_lock", tracking_lock)
+    real_load_store = auth_mod._load_auth_store
+    reads = []
+
+    def tracking_load_store(auth_file=None):
+        path = auth_file if auth_file is not None else auth_mod._auth_file_path()
+        key = str(path.resolve())
+        reads.append((key, key in held))
+        return real_load_store(auth_file)
+
+    monkeypatch.setattr(auth_mod, "_load_auth_store", tracking_load_store)
+    monkeypatch.setattr(CP, "_load_auth_store", tracking_load_store)
+    posts = []
+
+    b_new = _jwt("acct-B", "user-B", now + 8 * 3600)
+
+    def fake_refresh(_access_token, refresh_token):
+        posts.append((refresh_token, str(authoritative_path.resolve()) in held))
+        return {
+            "access_token": b_new,
+            "refresh_token": "YOUR_TEST_REFRESH_TOKEN_B2",
+            "last_refresh": _iso(time.time()),
+        }
+
+    monkeypatch.setattr(auth_mod, "refresh_codex_oauth_pure", fake_refresh)
+
+    first_pool = load_pool("openai-codex")
+    waiting_pool = load_pool("openai-codex")
+    first_entry = next(e for e in first_pool.entries() if e.id == "manual")
+    stale_entry = next(e for e in waiting_pool.entries() if e.id == "manual")
+    stale_root_snapshot = json.loads(authoritative_path.read_text(encoding="utf-8"))
+
+    first = first_pool._refresh_entry(first_entry, force=True)
+    if borrowed_root:
+        # Simulate a peer's stale global-root fallback cache. Refresh must read
+        # the authoritative file directly under its root lock.
+        monkeypatch.setattr(
+            auth_mod, "_load_global_auth_store", lambda: stale_root_snapshot
+        )
+    second = waiting_pool._refresh_entry(stale_entry, force=True)
+
+    assert first is not None and first.refresh_token == "YOUR_TEST_REFRESH_TOKEN_B2"
+    assert second is not None and second.refresh_token == "YOUR_TEST_REFRESH_TOKEN_B2"
+    assert posts == [("YOUR_TEST_REFRESH_TOKEN_B", True)]
+    assert (str(authoritative_path.resolve()), True) in reads
+    on_disk = json.loads(authoritative_path.read_text(encoding="utf-8"))
+    assert on_disk["providers"]["openai-codex"]["tokens"]["refresh_token"] == "YOUR_TEST_REFRESH_TOKEN_A"
