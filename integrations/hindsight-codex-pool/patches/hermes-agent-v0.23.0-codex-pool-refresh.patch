+    def _sync_codex_entry_from_pool_store(
+        self, entry: PooledCredential, auth_store_path: Path,
+    ) -> Optional[PooledCredential]:
+        """Re-read the exact Codex pool row under its owning auth-store lock.
+
+        Unlike a singleton-backed device_code alias, an independent manual row
+        has no provider.tokens shadow to resync from. Its persisted pool row is
+        the token authority after another process rotates the single-use pair.
+        """
+        try:
+            store = auth_mod._load_auth_store(auth_store_path)
+            pool = store.get("credential_pool")
+            rows = pool.get("openai-codex") if isinstance(pool, dict) else None
+            if not isinstance(rows, list):
+                rows = []
+            persisted = next(
+                (row for row in rows if isinstance(row, dict) and row.get("id") == entry.id),
+                None,
+            )
+            if not isinstance(persisted, dict):
+                logger.warning(
+                    "Codex pool entry %s is no longer readable; refusing stale refresh",
+                    entry.id[:8],
+                )
+                return None
+            self._persisted_token_pairs[entry.id] = auth_mod._credential_token_pair(persisted)
+            stored = PooledCredential.from_dict("openai-codex", persisted)
+            if not (stored.access_token or "").strip() and not (stored.refresh_token or "").strip():
+                logger.warning(
+                    "Codex pool entry %s has no persisted token pair; refusing stale refresh",
+                    entry.id[:8],
+                )
+                return None
+            if stored.access_token != entry.access_token or stored.refresh_token != entry.refresh_token:
+                self._replace_entry(entry, stored)
+                return stored
+            return entry
+        except Exception as exc:
+            logger.warning(
+                "Could not read the current Codex pool entry; refusing stale refresh (%s)",
+                type(exc).__name__,
+            )
+            return None
